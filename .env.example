# Copie este arquivo para ".env" (mesma pasta do main.py).
# Valores padrão do XAMPP: usuário root, SEM senha, porta 3306.
# Se o seu MySQL tiver senha, coloque depois do "=" em DB_PASSWORD.
# O arquivo .env não vai para o Git (está no .gitignore).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=patrimonio_imob
